{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-free-charts/chart",
  "version": "1.0.0",
  "title": "WP Free Charts",
  "category": "media",
  "icon": "chart-bar",
  "description": "Add interactive pie, bar, line and more chart types with spreadsheet data entry, theme colours, and front-end filters.",
  "keywords": [ "chart", "pie", "bar", "line", "graph", "data", "visualization" ],
  "textdomain": "wp-free-charts",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-view.css",
  "viewScript": "file:./view.js",
  "attributes": {
    "chartType":          { "type": "string",  "default": "bar" },
    "tableData":          { "type": "array",   "default": [ ["","Dataset 1"], ["January",30], ["February",50], ["March",40], ["April",70], ["May",60] ] },
    "title":              { "type": "string",  "default": "" },
    "showTitle":          { "type": "boolean", "default": false },
    "titleFontSize":      { "type": "string",  "default": "22px" },
    "titleFontFamily":    { "type": "string",  "default": "" },
    "titleColor":         { "type": "string",  "default": "#111111" },
    "titleAlign":         { "type": "string",  "default": "center" },
    "titleFontWeight":    { "type": "string",  "default": "bold" },
    "titleFontStyle":     { "type": "string",  "default": "normal" },
    "titleLineHeight":    { "type": "string",  "default": "" },
    "titleLetterSpacing": { "type": "string",  "default": "" },
    "showLegend":         { "type": "boolean", "default": true },
    "legendPosition":     { "type": "string",  "default": "top" },
    "legendAlign":        { "type": "string",  "default": "center" },
    "enableFilters":      { "type": "boolean", "default": false },
    "filterType":         { "type": "string",  "default": "dataset" },
    "chartHeight":        { "type": "string",  "default": "400px" },
    "backgroundColor":    { "type": "string",  "default": "" },
    "paddingTop":         { "type": "string",  "default": "24px" },
    "paddingRight":       { "type": "string",  "default": "24px" },
    "paddingBottom":      { "type": "string",  "default": "24px" },
    "paddingLeft":        { "type": "string",  "default": "24px" },
    "marginTop":          { "type": "string",  "default": "0" },
    "marginRight":        { "type": "string",  "default": "0" },
    "marginBottom":       { "type": "string",  "default": "0" },
    "marginLeft":         { "type": "string",  "default": "0" },
    "borderWidth":        { "type": "string",  "default": "0" },
    "borderColor":        { "type": "string",  "default": "#cccccc" },
    "borderRadius":       { "type": "string",  "default": "0" },
    "borderStyle":        { "type": "string",  "default": "solid" },
    "fontFamily":         { "type": "string",  "default": "" },
    "fontSize":           { "type": "number",  "default": 13 },
    "fontWeight":         { "type": "string",  "default": "" },
    "fontStyle":          { "type": "string",  "default": "normal" },
    "lineHeight":         { "type": "string",  "default": "" },
    "letterSpacing":      { "type": "string",  "default": "" },
    "textTransform":      { "type": "string",  "default": "" },
    "datasetColors":      { "type": "array",   "default": [] },
    "showGridX":          { "type": "boolean", "default": true },
    "showGridY":          { "type": "boolean", "default": true },
    "gridColor":          { "type": "string",  "default": "" },
    "tickColor":          { "type": "string",  "default": "" },
    "showTooltips":       { "type": "boolean", "default": true },
    "enableAnimation":    { "type": "boolean", "default": true },
    "stacked":            { "type": "boolean", "default": false },
    "xAxisLabel":         { "type": "string",  "default": "" },
    "yAxisLabel":         { "type": "string",  "default": "" },
    "tension":            { "type": "number",  "default": 0.3 },
    "pointRadius":        { "type": "number",  "default": 4 },
    "fillArea":           { "type": "boolean", "default": false },
    "barBorderRadius":    { "type": "number",  "default": 4 },
    "indexAxis":          { "type": "string",  "default": "x" },
    "cutout":             { "type": "number",  "default": 55 },
    "uniqueId":           { "type": "string",  "default": "" }
  },
  "supports": {
    "html":    false,
    "align":   [ "wide", "full" ],
    "spacing": false,
    "color":   { "background": false, "text": false }
  }
}
