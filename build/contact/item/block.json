{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-free-charts/contact-item",
  "version": "1.1.0",
  "title": "Contact Item",
  "category": "widgets",
  "parent": [
    "wp-free-charts/contact-details"
  ],
  "description": "One contact detail or social profile with an icon. Choose the type in the sidebar; style all items from the Contact Details block.",
  "keywords": [
    "email",
    "phone",
    "call",
    "mail",
    "social",
    "website"
  ],
  "textdomain": "wp-free-charts",
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "usesContext": [
    "wp-free-charts/showText",
    "wp-free-charts/itemStyle",
    "wp-free-charts/openInNewTab",
    "postId",
    "postType"
  ],
  "attributes": {
    "type": {
      "type": "string",
      "default": "email"
    },
    "value": {
      "type": "string",
      "default": ""
    },
    "label": {
      "type": "string",
      "default": ""
    },
    "source": {
      "type": "string",
      "default": "manual"
    },
    "field": {
      "type": "string",
      "default": ""
    },
    "fieldFrom": {
      "type": "string",
      "default": "post"
    }
  },
  "supports": {
    "html": false,
    "reusable": false
  }
}